{
  "file_scan_exclusions": [
    "**/.DS_Store",
    "**/.git",
    "**/build",
    ".astro",
    ".cloudflare",
    ".pnpm-store",
    ".vite-hooks",
    ".wrangler",
    "dist",
    "node_modules",
    "pnpm-lock.yaml"
  ],
  "languages": {
    "CSS": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "language_servers": ["oxfmt", "tailwindcss-intellisense-css"]
    },
    "HTML": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Markdown": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "TypeScript": {
      "code_actions_on_format": { "source.fixAll.oxc": true },
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "prettier": { "allowed": false }
    },
    "YAML": {
      "format_on_save": "on",
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    }
  },
  "lsp": {
    "oxfmt": {
      "binary": {
        "path": "node_modules/.bin/vp",
        "arguments": ["fmt", "--lsp"]
      },
      "initialization_options": {
        "settings": {
          "run": "onSave"
        }
      }
    },
    "oxlint": {
      "binary": {
        "path": "node_modules/.bin/vp",
        "arguments": ["lint", "--lsp"]
      },
      "initialization_options": {
        "settings": {
          "fixKind": "safe_fix",
          "run": "onType",
          "typeAware": true,
          "unusedDisableDirectives": "deny"
        }
      }
    }
  }
}
