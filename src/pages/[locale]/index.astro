---
import Layout from "@layouts/Layout.astro";
import Posts from "@components/Posts.astro";
import Ventures from "@components/Ventures.astro";
import { getTranslation, localeParams } from "@lib/i18n";

export const getStaticPaths = localeParams;

const t = getTranslation(Astro.currentLocale);
---

<Layout title="Armand Thuillart">
  <Ventures />
  <Posts count={2} label={t("latestPosts")} />
</Layout>
