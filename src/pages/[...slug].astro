---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { toMonthYear } from "@lib/date";
import Paragraph from "@components/Paragraph.astro";
import Anchor from "@components/Anchor.astro";
import HeadingTwo from "@components/HeadingTwo.astro";
import ListItem from "@components/ListItem.astro";
import UnorderedList from "@components/UnorderedList.astro";
import OrderedList from "@components/OrderedList.astro";
import Code from "@components/Code.astro";

import Posts from "@components/Posts.astro";
import Aside from "@components/Aside.astro";

export async function getStaticPaths() {
  const pages = await getCollection("blog");

  return pages.map((page) => {
    return {
      params: {
        slug: page.id === "index" ? undefined : page.id,
      },
      props: { page },
    };
  });
}

const { page } = Astro.props;
const { Content } = await render(page);

const index = Astro.url.pathname === "/";

const components = {
  a: Anchor,
  code: Code,
  h2: HeadingTwo,
  li: ListItem,
  ol: OrderedList,
  p: Paragraph,
  ul: UnorderedList,
};

const date = toMonthYear(page.data.date);
---

<BaseLayout title={page.data.title}>
  {!index && <Aside />}

  <article class="space-y-4">
    <header class="mb-6">
      <h1 class="font-medium">{page.data.title}</h1>
      <time class="text-muted-foreground">Updated {date}</time>
    </header>

    <Content components={components} />

    {index && <Posts />}
  </article>
</BaseLayout>
