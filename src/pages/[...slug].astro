---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import Paragraph from "@components/Paragraph.astro";
import Anchor from "@components/Anchor.astro";
import HeadingTwo from "@components/HeadingTwo.astro";
import ListItem from "@components/ListItem.astro";
import OrderedList from "@components/OrderedList.astro";
import Icon from "@components/Icon.astro";

import Posts from "@components/Posts.astro";
import Navigation from "@components/Navigation.astro";

export async function getStaticPaths() {
  const pages = await getCollection("blog");

  return pages.map((page) => {
    return {
      params: {
        slug: page.id === "index" ? undefined : page.id,
      },
      props: { page },
    };
  });
}

const { page } = Astro.props;
const { Content } = await render(page);

const index = Astro.url.pathname === "/";

function toMonthYear(date: Date) {
  const formatter = new Intl.DateTimeFormat("en-US", {
    day: "numeric",
    year: "numeric",
    month: "short",
  });
  return formatter.format(date);
}

const components = {
  a: Anchor,
  h2: HeadingTwo,
  li: ListItem,
  ol: OrderedList,
  p: Paragraph,
};

const date = toMonthYear(page.data.date);
---

<BaseLayout title={page.data.title}>
  {
    !index && (
      <aside class="static top-0 w-fit max-md:mb-8 md:fixed md:translate-y-28 md:max-xl:-translate-x-30 xl:-translate-x-60">
        <a
          class="not-hover:text-muted-foreground relative flex items-center gap-1 text-sm before:absolute before:-inset-4"
          href="/"
        >
          <Icon class="size-2.5" name="arrow-u-down-left" />
          <span class="text-xs leading-none">Home</span>
        </a>
      </aside>
    )
  }

  <article class="space-y-4">
    <header class="mb-6">
      <h1 class="font-medium">{page.data.title}</h1>
      <time class="text-muted-foreground">Updated {date}</time>
    </header>

    <Content components={components} />

    {index ? <Posts /> : <Navigation />}
  </article>
</BaseLayout>
