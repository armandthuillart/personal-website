---
const formatter = new Intl.DateTimeFormat("en-US", {
  hour: "numeric",
  hour12: true,
  minute: "2-digit",
  timeZone: "Europe/Paris",
});

const display = formatter.format(new Date()).replace(" ", "").toLowerCase();
---

<footer class="text-muted-foreground mt-10 mb-20 flex flex-col text-xs">
  <hr class="border-border h-px w-12.5" />
  <time class="mt-9">{display} in Paris, France ツ</time>
</footer>
