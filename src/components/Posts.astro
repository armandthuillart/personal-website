---
import { getCollection } from "astro:content";
import Footer from "@components/Footer.astro";

const posts = (await getCollection("blog"))
  .filter((post) => post.id !== "index")
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date!.valueOf() - a.data.date!.valueOf());
---

<div class="mt-9 space-y-1.5">
  <h3 class="text-muted">Writing</h3>

  <ul class="group/ul border-border flex flex-col border-t">
    {
      posts.map((post, i) => {
        const postYear = post.data.date?.getFullYear();
        const prevPost = posts[i - 1];
        const prevYear = prevPost
          ? new Date(prevPost.data.date!).getFullYear()
          : null;
        const hideYear = prevYear === postYear;

        const date = post.data.date.toLocaleDateString("en-US", {
          month: "numeric",
          day: "numeric",
        });

        return (
          <li class="group/li relative group-hover/ul:**:data-highlight:opacity-50 hover:**:data-highlight:opacity-100">
            <a
              class="border-border ml-12 flex h-10 not-group-last/li:border-b sm:ml-25"
              href={`/${post.id}`}
            >
              <div class="flex flex-1 items-center justify-between">
                <h2 data-highlight>{post.data.title}</h2>

                <time class="text-muted-foreground">
                  <span data-highlight>{date}</span>
                  {!hideYear && <span class="absolute left-0">{postYear}</span>}
                </time>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>
</div>

<Footer />
