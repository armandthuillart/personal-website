---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocale, localized } from "@lib/i18n";

interface Props {
  count: number;
  label: string;
}

const { count, label } = Astro.props;

const locale = getLocale(Astro.currentLocale);

const posts = (await localized("blog", locale))
  .filter(({ entry }) => !entry.data.draft)
  .sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf())
  .slice(0, count);
---

<div class="grid gap-5 grid-cols-1 sm:grid-cols-2">
  <h1 class="text-lg font-medium col-span-full">{label}</h1>

  {posts.map(({ entry: post, slug }) => (
    <a class="flex flex-col gap-3" href={getRelativeLocaleUrl(locale, `blog/${slug}`)}>
      <div
        class="aspect-video relative after:absolute after:inset-0 after:border after:rounded-lg after:border-border bg-muted rounded-lg overflow-hidden"
      >
        <Image
          alt={post.data.title}
          class="size-full dark:invert"
          height={900}
          loading="eager"
          src={post.data.image}
          width={1600}
        />
      </div>

      <div class="flex flex-col text-sm gap-1">
        <h2 class="line-clamp-1">{post.data.title}</h2>

        <p class="text-muted-foreground line-clamp-2">
          {post.data.date.toLocaleDateString(locale, {
            day: "numeric",
            month: "long",
            year: "numeric",
          })}
        </p>
      </div>
    </a>
  ))}
</div>
