---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  count: number;
  label: string;
}

const { count, label } = Astro.props;

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, count);
---

<div class="grid gap-5 grid-cols-1 sm:grid-cols-2" transition:name="posts">
  <h1 class="text-lg font-medium col-span-full">{label}</h1>

  {
    posts.map((post) => (
      <a class="flex flex-col gap-3" href={`/blog/${post.id}`}>
        <div
          class="aspect-video bg-muted rounded-lg"
          transition:name={`post-${post.id}`}
        >
          <Image
            alt={post.data.title}
            class="size-full hidden"
            height={900}
            loading="eager"
            src={post.data.image}
            width={1600}
          />
        </div>

        <div class="flex flex-col text-sm gap-1">
          <h2 class="line-clamp-1 ">{post.data.title}</h2>

          <p class="text-muted-foreground line-clamp-2">
            {post.data.description}
          </p>
        </div>
      </a>
    ))
  }
</div>
