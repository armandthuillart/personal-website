---
import "@styles/global.css";
import { Font } from "astro:assets";
import ogImage from "@public/og-image.png";

interface Props {
  title: string;
}

const { title } = Astro.props;

const isIndexPage = Astro.url.pathname === "/";
const pageTitle = isIndexPage ? title : `${title} · Armand Thuillart`;
---

<html lang="en" class="antialiased scheme-light-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <link
      rel="alternate"
      type="application/rss+xml"
      href={new URL("rss.xml", Astro.site)}
      title="Armand Thuillart"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content="Designer and developer." />

    <meta property="og:url" content={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Armand Thuillart" />
    <meta property="og:description" content="Designer and developer." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@armandthuillart" />
    <meta name="twitter:creator" content="@armandthuillart" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content="Designer and developer." />
    <meta name="twitter:image" content={new URL(ogImage.src, Astro.site)} />

    <Font cssVariable="--font-inter" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-fira-code" preload={[{ style: "normal" }]} />

    <script>
      let style = document.createElement("style");
      style.textContent = "* { transition: none !important; }";

      let mm = matchMedia("(prefers-color-scheme: dark)");

      mm.addEventListener("change", () => {
        if (!style.isConnected) document.head.append(style);
        requestAnimationFrame(() => {
          requestAnimationFrame(() => style.remove());
        });
      });
    </script>
  </head>

  <body
    class="bg-background text-foreground selection:bg-selection font-sans text-sm font-[460] tracking-[-0.005625em]"
  >
    <main class="mx-auto my-12 max-w-150 px-6 sm:my-28">
      <slot />
    </main>
  </body>
</html>
